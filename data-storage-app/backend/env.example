# Security
SECRET_KEY=your-very-secure-secret-key-change-this-in-production

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/data_storage
DATABASE_URL_ASYNC=postgresql+asyncpg://postgres:password@localhost:5432/data_storage

# Redis
