# Read by docker-compose.yml (copy to .env in the repository root).
# The backend container's own settings are set in the compose file;
# see backend/.env.example for the full list of backend keys.

# Required for anything beyond local testing. Generate with: openssl rand -hex 32
SECRET_KEY=replace-with-a-long-random-string

# Password for the postgres service; the compose file builds DATABASE_URL from it.
POSTGRES_PASSWORD=change-me

# development or production
ENVIRONMENT=development

# Optional
SENTRY_DSN=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SERVER=
