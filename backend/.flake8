[flake8]
max-line-length = 88
extend-ignore = E203,W503
exclude = .venv,__pycache__
# Pre-existing findings that need code changes (unused/side-effect imports,
# SQLAlchemy "== False" filters, long lines); tracked for a follow-up.
per-file-ignores =
    */*.py:F401,E402,E712,F811,E501
    *.py:F401,E402,E712,F811,E501
