# Backend settings. Copy to backend/.env (read from the working directory
# the app is started in). Every key below is a field of Settings in
# backend/app/core/config.py; unset keys fall back to the defaults there.

# Security. Generate with: openssl rand -hex 32
SECRET_KEY=replace-with-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database. SQLite is fine for local development; use PostgreSQL otherwise.
DATABASE_URL=sqlite:///./data_storage.db
DATABASE_URL_ASYNC=postgresql+asyncpg://postgres:change-me@localhost:5432/data_storage

# Redis (only used by the /health check)
REDIS_URL=redis://localhost:6379

# Mail (declared in Settings; no code sends mail yet)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SERVER=
MAIL_PORT=587
MAIL_TLS=true
MAIL_SSL=false

# Sentry (leave empty to disable)
SENTRY_DSN=

# Rate limiting (declared in Settings; limits in the routers are hard-coded)
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_LOGIN_ATTEMPTS=5

# development creates tables on startup; use "production" with Alembic.
# DEBUG=true enables /docs and /redoc and allows any CORS origin.
ENVIRONMENT=development
DEBUG=true
